# Copy to .env and fill in values. Never commit .env.

# Daytona — https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Nosana — https://deploy.nosana.com
NOSANA_API_KEY=
NOSANA_LLM_URL=
NOSANA_LLM_MODEL=gpt-oss:20b
NOSANA_DEPLOYMENT_URL=https://deploy.nosana.com/deployments
NOSANA_LOGS_URL=
NOSANA_JOB_URL=https://explore.nosana.com

# Neo4j Aura Bolt (instance user/password, not Aura API client creds)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=

# Optional Aura API metadata (not used for Bolt)
NEO4J_CLIENT_NAME=
NEO4J_CLIENT_ID=
NEO4J_CLIENT_SECRET=
